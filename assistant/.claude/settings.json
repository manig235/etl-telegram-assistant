      "Bash(./bin/weather:*)",
      "Bash(date)",
      "Bash(date:*)",
      "Read(/notes/**)",
      "Edit(/notes/**)",
      "Write(/notes/**)",
      "mcp__notion__*",
      "mcp__claude_ai_Google_Calendar__*",
