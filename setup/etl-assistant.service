[Unit]
Description=eTL & schedule assistant (Claude Code + Telegram) in tmux
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# %h = your home directory. Change the path if you cloned the repo somewhere else.
ExecStart=/usr/bin/tmux new-session -d -s etl-assistant -x 200 -y 50 %h/etl-assistant/assistant/start.sh
ExecStop=-/usr/bin/tmux kill-session -t etl-assistant

[Install]
WantedBy=default.target
